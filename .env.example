# ==============================================================================
# METACRM ENVIRONMENT VARIABLES & SECRETS (VERCEL DEPLOYMENT)
# Configure these in your Vercel Dashboard under:
# Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE CONFIGURATION (PostgreSQL, Auth & Realtime)
# Found in: Supabase Project Settings -> Database / API
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. META / FACEBOOK DEVELOPER APP CONFIGURATION
# Found in: developers.facebook.com -> App Settings -> Basic
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_API_VERSION=v24.0
META_REDIRECT_URI=https://your-project.vercel.app/api/meta/callback
META_VERIFY_TOKEN=your_meta_webhook_verify_token_here

# Permanent Meta System User Token (for offline serverless tasks)
META_ACCESS_TOKEN=EAAG...your_permanent_system_user_token

# ------------------------------------------------------------------------------
# 3. GOOGLE WORKSPACE / GMAIL API OAUTH
# Found in: Google Cloud Console -> APIs & Services -> Credentials
# Scopes: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.send
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/email/oauth?provider=google

# ------------------------------------------------------------------------------
# 4. MICROSOFT 365 / ENTRA ID GRAPH API OAUTH
# Found in: Microsoft Entra admin center -> App registrations
# Scopes: Mail.Read, Mail.Send, offline_access, User.Read
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=your_microsoft_entra_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_value
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://your-project.vercel.app/api/email/oauth?provider=microsoft

# ------------------------------------------------------------------------------
# 5. ZERNIO UNIFIED MARKETING API (Optional Gateway)
# Bypasses Meta Developer App Review, Business Verification & manual token pasting
# ------------------------------------------------------------------------------
ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_PROFILE_ID=your_zernio_profile_id_here
ZERNIO_BASE_URL=https://zernio.com/api/v1

# ------------------------------------------------------------------------------
# 6. APP SECURITY & VERCEL DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
ENCRYPTION_KEY=32_character_hex_encryption_key_here
CRON_SECRET=super_secret_cron_key_for_scheduled_sync

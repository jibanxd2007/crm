{
  "version": 2,
  "crons": [
    {
      "path": "/api/meta/ad-spend-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/meta/sync",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/integrations/(.*)",
      "destination": "/api/integrations"
    },
    {
      "source": "/api/integrations",
      "destination": "/api/integrations"
    },
    {
      "source": "/api/email/oauth/(.*)",
      "destination": "/api/email/oauth"
    },
    {
      "source": "/api/email/oauth",
      "destination": "/api/email/oauth"
    },
    {
      "source": "/api/email/messages/(.*)",
      "destination": "/api/email/messages"
    },
    {
      "source": "/api/email/messages",
      "destination": "/api/email/messages"
    },
    {
      "source": "/api/conversations/(.*)",
      "destination": "/api/messages"
    },
    {
      "source": "/api/conversations",
      "destination": "/api/messages"
    },
    {
      "source": "/api/messages/(.*)",
      "destination": "/api/messages"
    },
    {
      "source": "/api/leads/(.*)",
      "destination": "/api/leads"
    },
    {
      "source": "/api/pages/(.*)",
      "destination": "/api/pages"
    },
    {
      "source": "/api/staff/(.*)",
      "destination": "/api/staff"
    },
    {
      "source": "/api/reports/(.*)",
      "destination": "/api/reports"
    },
    {
      "source": "/api/notifications/(.*)",
      "destination": "/api/notifications"
    },
    {
      "source": "/api/auth/meta/url",
      "destination": "/api/meta/oauth"
    },
    {
      "source": "/api/auth/meta/callback",
      "destination": "/api/meta/oauth"
    },
    {
      "source": "/api/meta/callback",
      "destination": "/api/meta/oauth"
    },
    {
      "source": "/api/webhooks/meta",
      "destination": "/api/meta/webhook"
    },
    {
      "source": "/api/meta/ad-spend-sync",
      "destination": "/api/meta/sync?type=ad-spend"
    },
    {
      "source": "/api/ad-spend-sync",
      "destination": "/api/meta/sync?type=ad-spend"
    },
    {
      "source": "/api/campaigns",
      "destination": "/api/meta/campaigns"
    },
    {
      "source": "/api/meta/insights",
      "destination": "/api/meta/campaigns?action=insights"
    },
    {
      "source": "/api/meta/assets/(.*)",
      "destination": "/api/meta/campaigns?action=assets"
    },
    {
      "source": "/api/meta/assets",
      "destination": "/api/meta/campaigns?action=assets"
    },
    {
      "source": "/api/zernio/connect/(.*)",
      "destination": "/api/zernio?path=connect&channel=$1"
    },
    {
      "source": "/api/zernio/connect",
      "destination": "/api/zernio?path=connect"
    },
    {
      "source": "/api/zernio/status",
      "destination": "/api/zernio?path=status"
    },
    {
      "source": "/api/zernio/accounts",
      "destination": "/api/zernio?path=accounts"
    },
    {
      "source": "/api/zernio/inbox/conversations/(.*)/messages",
      "destination": "/api/zernio?path=inbox-messages&conversationId=$1"
    },
    {
      "source": "/api/zernio/inbox/conversations/(.*)",
      "destination": "/api/zernio?path=inbox-conv&conversationId=$1"
    },
    {
      "source": "/api/zernio/inbox/conversations",
      "destination": "/api/zernio?path=inbox-conversations"
    },
    {
      "source": "/api/zernio/simulate-lead",
      "destination": "/api/zernio?path=simulate-lead"
    },
    {
      "source": "/api/webhooks/zernio",
      "destination": "/api/zernio?path=webhook"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}

{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/meta?path=sync&type=ad-spend",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/meta?path=sync",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    },
    {
      "source": "/api/integrations/(.*)",
      "destination": "/api/integrations.js"
    },
    {
      "source": "/api/integrations",
      "destination": "/api/integrations.js"
    },
    {
      "source": "/api/email/oauth/(.*)",
      "destination": "/api/email.js?path=oauth&$1"
    },
    {
      "source": "/api/email/oauth",
      "destination": "/api/email.js?path=oauth"
    },
    {
      "source": "/api/email/messages/(.*)",
      "destination": "/api/email.js?path=messages&$1"
    },
    {
      "source": "/api/email/messages",
      "destination": "/api/email.js?path=messages"
    },
    {
      "source": "/api/email/(.*)",
      "destination": "/api/email.js"
    },
    {
      "source": "/api/email",
      "destination": "/api/email.js"
    },
    {
      "source": "/api/conversations/(.*)",
      "destination": "/api/messages.js"
    },
    {
      "source": "/api/conversations",
      "destination": "/api/messages.js"
    },
    {
      "source": "/api/messages/(.*)",
      "destination": "/api/messages.js"
    },
    {
      "source": "/api/messages",
      "destination": "/api/messages.js"
    },
    {
      "source": "/api/leads/(.*)",
      "destination": "/api/leads.js"
    },
    {
      "source": "/api/leads",
      "destination": "/api/leads.js"
    },
    {
      "source": "/api/pages/(.*)",
      "destination": "/api/pages.js"
    },
    {
      "source": "/api/pages",
      "destination": "/api/pages.js"
    },
    {
      "source": "/api/staff/(.*)",
      "destination": "/api/staff.js"
    },
    {
      "source": "/api/staff",
      "destination": "/api/staff.js"
    },
    {
      "source": "/api/reports/(.*)",
      "destination": "/api/reports.js"
    },
    {
      "source": "/api/reports",
      "destination": "/api/reports.js"
    },
    {
      "source": "/api/notifications/(.*)",
      "destination": "/api/notifications.js"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/notifications.js"
    },
    {
      "source": "/api/auth/meta/url",
      "destination": "/api/meta.js?path=oauth"
    },
    {
      "source": "/api/auth/meta/callback",
      "destination": "/api/meta.js?path=oauth"
    },
    {
      "source": "/api/meta/callback",
      "destination": "/api/meta.js?path=oauth"
    },
    {
      "source": "/api/webhooks/meta",
      "destination": "/api/meta.js?path=webhook"
    },
    {
      "source": "/api/meta/roi",
      "destination": "/api/meta.js?action=roi"
    },
    {
      "source": "/api/meta/ad-spend-sync",
      "destination": "/api/meta.js?path=sync&type=ad-spend"
    },
    {
      "source": "/api/ad-spend-sync",
      "destination": "/api/meta.js?path=sync&type=ad-spend"
    },
    {
      "source": "/api/meta/sync",
      "destination": "/api/meta.js?path=sync"
    },
    {
      "source": "/api/campaigns",
      "destination": "/api/meta.js"
    },
    {
      "source": "/api/meta/insights",
      "destination": "/api/meta.js?action=insights"
    },
    {
      "source": "/api/meta/assets/(.*)",
      "destination": "/api/meta.js?action=assets"
    },
    {
      "source": "/api/meta/assets",
      "destination": "/api/meta.js?action=assets"
    },
    {
      "source": "/api/meta/(.*)",
      "destination": "/api/meta.js"
    },
    {
      "source": "/api/meta",
      "destination": "/api/meta.js"
    },
    {
      "source": "/api/zernio/connect/(.*)",
      "destination": "/api/zernio.js?path=connect&channel=$1"
    },
    {
      "source": "/api/zernio/connect",
      "destination": "/api/zernio.js?path=connect"
    },
    {
      "source": "/api/zernio/status",
      "destination": "/api/zernio.js?path=status"
    },
    {
      "source": "/api/zernio/accounts",
      "destination": "/api/zernio.js?path=accounts"
    },
    {
      "source": "/api/zernio/inbox/conversations/(.*)/messages",
      "destination": "/api/zernio.js?path=inbox-messages&conversationId=$1"
    },
    {
      "source": "/api/zernio/inbox/conversations/(.*)",
      "destination": "/api/zernio.js?path=inbox-conv&conversationId=$1"
    },
    {
      "source": "/api/zernio/inbox/conversations",
      "destination": "/api/zernio.js?path=inbox-conversations"
    },
    {
      "source": "/api/zernio/simulate-lead",
      "destination": "/api/zernio.js?path=simulate-lead"
    },
    {
      "source": "/api/webhooks/zernio",
      "destination": "/api/zernio.js?path=webhook"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*html|)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
